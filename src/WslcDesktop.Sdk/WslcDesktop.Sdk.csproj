<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Microsoft.WSL.Containers SDK adapter for ISessionBackend. Windows-only; no WinUI. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>WslcDesktop.Sdk</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64;ARM64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WSL.Containers" Version="3.0.3" />
    <ProjectReference Include="..\WslcDesktop.Core\WslcDesktop.Core.csproj" />
  </ItemGroup>

</Project>
