<UserControl
    x:Class="WslcDesktop.Controls.RawJsonExpander"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:localization="using:WslcDesktop.Localization"
    xmlns:controls="using:WslcDesktop.Controls">

    <Expander
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        Header="{localization:Localized Key=RawJSON}"
        IsExpanded="False">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="360" />
            </Grid.RowDefinitions>
            <Button x:Name="CopyButton" Click="Copy_Click" Content="{localization:Localized Key=ActionCopyJson}" HorizontalAlignment="Right" />
            <controls:OutputView x:Name="Output" Grid.Row="1" />
        </Grid>
    </Expander>
</UserControl>
