<UserControl
    x:Class="WslcDesktop.Controls.TerminalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:localization="using:WslcDesktop.Localization"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    IsTabStop="True"
    UseSystemFocusVisuals="False">

    <!-- Drawn by Win2D inside the XAML tree, so it clips, themes and overlays like any other control. -->
    <Border
        x:Name="Frame"
        AutomationProperties.Name="{localization:Localized Key=Terminal}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{ThemeResource ControlCornerRadius}"
        Padding="6,4,0,0">
        <canvas:CanvasControl
            x:Name="Surface"
            ClearColor="Transparent"
            CreateResources="Surface_CreateResources"
            Draw="Surface_Draw"
            SizeChanged="Surface_SizeChanged"
            PointerPressed="Surface_PointerPressed"
            PointerMoved="Surface_PointerMoved"
            PointerReleased="Surface_PointerReleased"
            PointerWheelChanged="Surface_PointerWheelChanged" />
    </Border>
</UserControl>
