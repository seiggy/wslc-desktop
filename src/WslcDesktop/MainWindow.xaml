<Window
    x:Class="WslcDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:localization="using:WslcDesktop.Localization"
    Title="{localization:Localized Key=AppTitle}">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="{localization:Localized Key=AppTitle}" />

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Left"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="{localization:Localized Key=LabelContainers}" Icon="Library" Tag="containers" />
                <NavigationViewItem Content="{localization:Localized Key=Stacks}" Tag="stacks">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF168;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{localization:Localized Key=Images}" Tag="images">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{localization:Localized Key=Volumes}" Icon="Folder" Tag="volumes" />
                <NavigationViewItem Content="{localization:Localized Key=Networks}" Icon="World" Tag="networks" />
                <NavigationViewItem Content="{localization:Localized Key=Secrets}" Icon="Permissions" Tag="secrets" />
                <NavigationViewItem Content="{localization:Localized Key=LabelEnvironment}" Icon="AllApps" Tag="sessions" />
            </NavigationView.MenuItems>

            <Grid>
                <Frame x:Name="ContentFrame" />

                <StackPanel
                    x:Name="StartupPanel"
                    MaxWidth="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <TextBlock x:Name="StartupTitle" Style="{StaticResource SubtitleTextBlockStyle}" Text="{localization:Localized Key=StartingWSLc}" />
                    <TextBlock
                        x:Name="StartupDetail"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <ProgressBar x:Name="StartupProgress" IsIndeterminate="True" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="InstallButton" Click="Install_Click" Content="{localization:Localized Key=InstallComponents}" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" />
                        <Button x:Name="RetryButton" Click="Retry_Click" Content="{localization:Localized Key=ActionRetry}" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
