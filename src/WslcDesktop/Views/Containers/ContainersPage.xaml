<Page
    x:Class="WslcDesktop.Views.Containers.ContainersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:localization="using:WslcDesktop.Localization"
    xmlns:svc="using:WslcDesktop.ViewModels">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{localization:Localized Key=LabelContainers}" />
            <ComboBox
                x:Name="SessionFilter"
                Grid.Column="1"
                MinWidth="200"
                AutomationProperties.Name="{localization:Localized Key=FilterBySession}" />
            <Button Grid.Column="2" Click="New_Click" Content="{localization:Localized Key=NewContainer}" Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar
                x:Name="ErrorBar"
                IsClosable="True"
                IsOpen="False"
                Severity="Error" />
            <InfoBar x:Name="SessionErrorBar" IsClosable="False" IsOpen="False" Severity="Warning" Title="{localization:Localized Key=SomeSessionsCouldnTBeRead}" />
        </StackPanel>

        <Grid Grid.Row="2" Padding="16,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="136" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource ColumnHeaderStyle}" Text="{localization:Localized Key=LabelName}" />
            <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeaderStyle}" Text="{localization:Localized Key=LabelSession}" />
            <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeaderStyle}" Text="{localization:Localized Key=LabelState}" />
            <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeaderStyle}" Text="{localization:Localized Key=LabelRestart}" />
            <!-- Usage cells collapse as the list narrows: network and disk first, then the CPU and memory charts, then their values. -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="16">
                <TextBlock Width="56" Style="{StaticResource ColumnHeaderStyle}" Text="{localization:Localized Key=Network}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind Columns.IoVisibility, Mode=OneWay}" />
                <TextBlock Width="56" Style="{StaticResource ColumnHeaderStyle}" Text="{localization:Localized Key=DiskIO}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind Columns.IoVisibility, Mode=OneWay}" />
                <TextBlock Width="{x:Bind Columns.CpuWidth, Mode=OneWay}" Style="{StaticResource ColumnHeaderStyle}" Text="{localization:Localized Key=LabelCpu}" Visibility="{x:Bind Columns.ValueVisibility, Mode=OneWay}" />
                <TextBlock Width="{x:Bind Columns.MemoryWidth, Mode=OneWay}" Style="{StaticResource ColumnHeaderStyle}" Text="{localization:Localized Key=LabelMemory}" Visibility="{x:Bind Columns.ValueVisibility, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <ListView
            x:Name="List"
            Grid.Row="3"
            IsItemClickEnabled="True"
            ItemClick="List_ItemClick"
            ItemContainerStyle="{StaticResource RowItemStyle}"
            SelectionMode="None"
            SizeChanged="List_SizeChanged">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="svc:ContainerItem">
                    <StackPanel>
                        <TextBlock
                            Margin="16,8,0,0"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Header, Mode=OneWay}"
                            Visibility="{x:Bind HeaderVisibility, Mode=OneWay}" />
                    <Grid Padding="16,8" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="136" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ImageText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Session}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Border Padding="6,1" VerticalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Visibility="{x:Bind ThisAppVisibility}">
                                <TextBlock FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Text="{localization:Localized Key=ThisApp}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind RunningVisibility, Mode=OneWay}" />
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource TextFillColorDisabledBrush}" Visibility="{x:Bind StoppedVisibility, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind State, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" Foreground="{x:Bind RestartBrush, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Restart, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Restart, Mode=OneWay}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <Grid
                                Width="56"
                                Height="20"
                                AutomationProperties.Name="{x:Bind NetTip, Mode=OneWay}"
                                Background="Transparent"
                                ToolTipService.ToolTip="{x:Bind NetTip, Mode=OneWay}"
                                Visibility="{x:Bind Columns.IoVisibility, Mode=OneWay}">
                                <Polyline Points="{x:Bind NetRxPoints, Mode=OneWay}" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1.5" />
                                <Polyline Points="{x:Bind NetTxPoints, Mode=OneWay}" Stroke="{ThemeResource SystemFillColorCautionBrush}" StrokeThickness="1.5" />
                            </Grid>
                            <Grid
                                Width="56"
                                Height="20"
                                AutomationProperties.Name="{x:Bind DiskTip, Mode=OneWay}"
                                Background="Transparent"
                                ToolTipService.ToolTip="{x:Bind DiskTip, Mode=OneWay}"
                                Visibility="{x:Bind Columns.IoVisibility, Mode=OneWay}">
                                <Polyline Points="{x:Bind DiskReadPoints, Mode=OneWay}" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1.5" />
                                <Polyline Points="{x:Bind DiskWritePoints, Mode=OneWay}" Stroke="{ThemeResource SystemFillColorCautionBrush}" StrokeThickness="1.5" />
                            </Grid>
                            <StackPanel Width="{x:Bind Columns.CpuWidth, Mode=OneWay}" Orientation="Horizontal" Spacing="8" Visibility="{x:Bind Columns.ValueVisibility, Mode=OneWay}">
                                <Polyline
                                    Width="56"
                                    Height="20"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Points="{x:Bind CpuPoints, Mode=OneWay}"
                                    Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                    StrokeThickness="1.5"
                                    Visibility="{x:Bind Columns.ChartVisibility, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind Cpu, Mode=OneWay}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Width="{x:Bind Columns.MemoryWidth, Mode=OneWay}" Orientation="Horizontal" Spacing="8" Visibility="{x:Bind Columns.ValueVisibility, Mode=OneWay}">
                                <Polyline
                                    Width="56"
                                    Height="20"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Points="{x:Bind MemoryPoints, Mode=OneWay}"
                                    Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                    StrokeThickness="1.5"
                                    Visibility="{x:Bind Columns.ChartVisibility, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind Memory, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" VerticalAlignment="Center">
                            <Button
                                AutomationProperties.Name="{localization:Localized Key=ActionStart}"
                                Click="Start_Click"
                                Content="&#xE768;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                IsEnabled="{x:Bind IsStopped, Mode=OneWay}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="{localization:Localized Key=ActionStart}" />
                            <Button
                                AutomationProperties.Name="{localization:Localized Key=ActionStop}"
                                Click="Stop_Click"
                                Content="&#xE71A;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                IsEnabled="{x:Bind IsRunning, Mode=OneWay}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="{localization:Localized Key=ActionStop}" />
                            <Button
                                AutomationProperties.Name="{localization:Localized Key=ActionDelete}"
                                Click="Delete_Click"
                                Content="&#xE74D;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="{localization:Localized Key=ActionDelete}" />
                        </StackPanel>
                    </Grid>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Name="EmptyText"
            Grid.Row="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{localization:Localized Key=NoContainersYetCreateOneFromAnImage}"
            Visibility="Collapsed" />
    </Grid>
</Page>
