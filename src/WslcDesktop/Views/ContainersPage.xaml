<Page
    x:Class="WslcDesktop.Views.ContainersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:WslcDesktop.Services">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Containers" />
            <Button Grid.Column="1" Click="New_Click" Content="New container" Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <InfoBar
            x:Name="ErrorBar"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False"
            Severity="Error" />

        <Grid Grid.Row="2" Padding="12,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="230" />
            </Grid.ColumnDefinitions>
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Name" />
            <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Image" />
            <TextBlock Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="State" />
            <TextBlock Grid.Column="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="CPU" />
            <TextBlock Grid.Column="4" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Memory" />
        </Grid>

        <ListView
            x:Name="List"
            Grid.Row="3"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="svc:ContainerItem">
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="230" />
                        </Grid.ColumnDefinitions>
                        <HyperlinkButton
                            Padding="0"
                            Click="Details_Click"
                            Content="{x:Bind Name}"
                            Tag="{x:Bind Name}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Image, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{x:Bind State, Mode=OneWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Cpu, Mode=OneWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{x:Bind Memory, Mode=OneWay}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4">
                            <Button Click="Details_Click" Content="Details" Tag="{x:Bind Name}" />
                            <Button Click="Start_Click" Content="Start" IsEnabled="{x:Bind IsStopped, Mode=OneWay}" Tag="{x:Bind Name}" />
                            <Button Click="Stop_Click" Content="Stop" IsEnabled="{x:Bind IsRunning, Mode=OneWay}" Tag="{x:Bind Name}" />
                            <Button Click="Delete_Click" Content="Delete" Tag="{x:Bind Name}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Name="EmptyText"
            Grid.Row="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="No containers yet. Create one from an image."
            Visibility="Collapsed" />
    </Grid>
</Page>
