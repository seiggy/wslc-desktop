<Page
    x:Class="WslcDesktop.Views.ContainersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:WslcDesktop.Services">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Containers" />
            <Button Grid.Column="1" Click="Refresh_Click" Content="Refresh" />
            <Button Grid.Column="2" Click="New_Click" Content="New container" Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <ListView
            x:Name="List"
            Grid.Row="1"
            x:DefaultBindMode="OneTime"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="svc:ContainerRow">
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Image}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{x:Bind State}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                            <Button Click="Details_Click" Content="Details" Tag="{x:Bind Name}" />
                            <Button Click="Start_Click" Content="Start" Tag="{x:Bind Name}" />
                            <Button Click="Stop_Click" Content="Stop" Tag="{x:Bind Name}" />
                            <Button Click="Inspect_Click" Content="Inspect" Tag="{x:Bind Name}" />
                            <Button Click="Delete_Click" Content="Delete" Tag="{x:Bind Name}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Name="EmptyText"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="No containers yet. Create one from an image."
            Visibility="Collapsed" />
    </Grid>
</Page>
