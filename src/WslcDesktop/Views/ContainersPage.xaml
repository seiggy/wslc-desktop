<Page
    x:Class="WslcDesktop.Views.ContainersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:WslcDesktop.Services">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Containers" />
            <Button Grid.Column="1" Click="New_Click" Content="New container" Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <InfoBar
            x:Name="ErrorBar"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False"
            Severity="Error" />

        <Grid Grid.Row="2" Padding="16,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="136" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource ColumnHeaderStyle}" Text="Name" />
            <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeaderStyle}" Text="State" />
            <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeaderStyle}" Text="Restart" />
            <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeaderStyle}" Text="CPU" />
            <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeaderStyle}" Text="Memory" />
        </Grid>

        <ListView
            x:Name="List"
            Grid.Row="3"
            IsItemClickEnabled="True"
            ItemClick="List_ItemClick"
            ItemContainerStyle="{StaticResource RowItemStyle}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="svc:ContainerItem">
                    <StackPanel>
                        <TextBlock
                            Margin="16,8,0,0"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Header, Mode=OneWay}"
                            Visibility="{x:Bind HeaderVisibility, Mode=OneWay}" />
                    <Grid Padding="16,8" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="136" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ImageText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind RunningVisibility, Mode=OneWay}" />
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource TextFillColorDisabledBrush}" Visibility="{x:Bind StoppedVisibility, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind State, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Foreground="{x:Bind RestartBrush, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Restart, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Restart, Mode=OneWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Cpu, Mode=OneWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{x:Bind Memory, Mode=OneWay}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" VerticalAlignment="Center">
                            <Button
                                AutomationProperties.Name="Start"
                                Click="Start_Click"
                                Content="&#xE768;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                IsEnabled="{x:Bind IsStopped, Mode=OneWay}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Tag="{x:Bind Name}"
                                ToolTipService.ToolTip="Start" />
                            <Button
                                AutomationProperties.Name="Stop"
                                Click="Stop_Click"
                                Content="&#xE71A;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                IsEnabled="{x:Bind IsRunning, Mode=OneWay}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Tag="{x:Bind Name}"
                                ToolTipService.ToolTip="Stop" />
                            <Button
                                AutomationProperties.Name="Delete"
                                Click="Delete_Click"
                                Content="&#xE74D;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Tag="{x:Bind Name}"
                                ToolTipService.ToolTip="Delete" />
                        </StackPanel>
                    </Grid>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Name="EmptyText"
            Grid.Row="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="No containers yet. Create one from an image."
            Visibility="Collapsed" />
    </Grid>
</Page>
