<Page
    x:Class="WslcDesktop.Views.ImageDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WslcDesktop.Controls">

    <Page.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button
                AutomationProperties.Name="Back to images"
                Click="Back_Click"
                Content="&#xE72B;"
                FontFamily="{StaticResource SymbolThemeFontFamily}" />
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="0,0,16,0">
                <InfoBar x:Name="ErrorBar" IsClosable="False" IsOpen="False" Severity="Error" />

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Overview" />
                        <StackPanel x:Name="OverviewRows" Spacing="8" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="LayersTitle" Style="{StaticResource SubtitleTextBlockStyle}" Text="Layers" />
                        <InfoBar
                            IsClosable="False"
                            IsOpen="True"
                            Message="WSLc reports each layer's digest but not its size or the command that created it, so only digests are shown."
                            Severity="Informational" />
                        <StackPanel x:Name="LayerRows" Spacing="4" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Configuration" />
                        <StackPanel x:Name="ConfigRows" Spacing="8" />
                    </StackPanel>
                </Border>

                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="Raw inspect output">
                    <controls:OutputView x:Name="RawView" Height="360" />
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
