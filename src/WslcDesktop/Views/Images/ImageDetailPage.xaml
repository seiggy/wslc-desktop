<Page
    x:Class="WslcDesktop.Views.Images.ImageDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:localization="using:WslcDesktop.Localization"
    xmlns:controls="using:WslcDesktop.Controls">

    <Page.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button
                AutomationProperties.Name="{localization:Localized Key=BackToImages}"
                Click="Back_Click"
                Content="&#xE72B;"
                FontFamily="{StaticResource SymbolThemeFontFamily}" />
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button
                x:Name="RunButton"
                AutomationProperties.Name="{localization:Localized Key=RunAContainerFromThisImage}"
                Click="Run_Click"
                IsEnabled="False"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE768;" />
                    <TextBlock Text="{localization:Localized Key=RunContainer}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="0,0,16,0">
                <InfoBar x:Name="ErrorBar" IsClosable="False" IsOpen="False" Severity="Error" />

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{localization:Localized Key=Overview}" />
                        <StackPanel x:Name="OverviewRows" Spacing="8" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="LayersTitle" Style="{StaticResource SubtitleTextBlockStyle}" Text="{localization:Localized Key=Layers}" />
                        <InfoBar
                            IsClosable="False"
                            IsOpen="True"
                            Message="{localization:Localized Key=WSLcReportsEachLayerSDigestButNotIts}"
                            Severity="Informational" />
                        <StackPanel x:Name="LayerRows" Spacing="4" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{localization:Localized Key=Configuration}" />
                        <StackPanel x:Name="ConfigRows" Spacing="8" />
                    </StackPanel>
                </Border>

                <controls:RawJsonExpander x:Name="RawView" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
