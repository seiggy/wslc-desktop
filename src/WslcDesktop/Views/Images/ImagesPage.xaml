<Page
    x:Class="WslcDesktop.Views.Images.ImagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:WslcDesktop.ViewModels">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Images" />
            <ComboBox
                x:Name="SessionFilter"
                Grid.Column="1"
                MinWidth="200"
                AutomationProperties.Name="Filter by session" />
        </Grid>

        <Grid ColumnSpacing="8" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="PullBox"
                KeyDown="PullBox_KeyDown"
                PlaceholderText="Pull an image, e.g. docker.io/library/alpine:latest" />
            <Button x:Name="PullButton" Grid.Column="1" Click="Pull_Click" Content="Pull" Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <StackPanel Grid.Row="2" Spacing="8">
            <InfoBar x:Name="SessionErrorBar" IsClosable="False" IsOpen="False" Severity="Warning" Title="Some sessions couldn't be read" />
            <StackPanel x:Name="PullStatus" Spacing="4" Visibility="Collapsed">
                <TextBlock x:Name="PullText" />
                <ProgressBar x:Name="PullBar" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="3" Padding="16,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource ColumnHeaderStyle}" Text="Name" />
            <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeaderStyle}" Text="Session" />
            <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeaderStyle}" Text="Status" />
            <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeaderStyle}" Text="In use" />
            <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeaderStyle}" Text="Size" />
            <TextBlock Grid.Column="5" Style="{StaticResource ColumnHeaderStyle}" Text="Created" />
        </Grid>

        <ListView
            x:Name="List"
            Grid.Row="4"
            x:DefaultBindMode="OneWay"
            IsItemClickEnabled="True"
            ItemClick="List_ItemClick"
            ItemContainerStyle="{StaticResource RowItemStyle}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="svc:ImageItem">
                    <Grid Padding="16,8" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="160" />
                                        <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ShortId}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Session}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Border Padding="6,1" VerticalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Visibility="{x:Bind ThisAppVisibility}">
                                            <TextBlock FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Text="This app" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind TaggedVisibility}" />
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind UntaggedVisibility}" />
                            <TextBlock Text="{x:Bind TagStatus}" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{x:Bind UsedBy}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{x:Bind Size}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="{x:Bind CreatedSince}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="6" Orientation="Horizontal">
                            <Button
                                AutomationProperties.Name="Run a container from this image"
                                Click="Run_Click"
                                Content="&#xE768;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="Run a container from this image" />
                            <Button
                                AutomationProperties.Name="Delete"
                                Click="Delete_Click"
                                Content="&#xE74D;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="Delete" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Name="EmptyText"
            Grid.Row="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="No images yet. Pull one to get started."
            Visibility="Collapsed" />
    </Grid>
</Page>
