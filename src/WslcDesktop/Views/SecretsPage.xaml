<Page
    x:Class="WslcDesktop.Views.SecretsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:WslcDesktop.ViewModels">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Secrets" />

        <TextBlock
            Grid.Row="1"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Values are kept in Windows Credential Manager, never in compose files or app settings. Reference one as ${secret:NAME} in an environment value; it's resolved only when a container is created, and shown as the token everywhere in this app."
            TextWrapping="Wrap" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button Click="Add_Click" Content="Add secret" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <InfoBar x:Name="ErrorBar" Grid.Row="3" IsClosable="False" IsOpen="False" Severity="Error" />

        <Grid Grid.Row="4" Padding="16,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition Width="*" MinWidth="140" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource ColumnHeaderStyle}" Text="Name" />
            <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeaderStyle}" Text="Value" />
            <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeaderStyle}" Text="Updated" />
        </Grid>

        <ListView
            x:Name="List"
            Grid.Row="5"
            x:DefaultBindMode="OneWay"
            ItemContainerStyle="{StaticResource RowItemStyle}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="svc:SecretItem">
                    <Grid Padding="16,8" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="*" MinWidth="140" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Label}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind HasLabel}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            FontFamily="Cascadia Mono, Consolas"
                            IsTextSelectionEnabled="{x:Bind IsRevealed}"
                            Text="{x:Bind Display}"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Grid.Column="2"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ModifiedText}"
                            VerticalAlignment="Center" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
                            <Button
                                AutomationProperties.Name="Reveal or hide value"
                                Click="Reveal_Click"
                                Content="{x:Bind RevealGlyph}"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Tag="{x:Bind Name}"
                                ToolTipService.ToolTip="Reveal or hide value" />
                            <Button
                                AutomationProperties.Name="Copy token"
                                Click="CopyToken_Click"
                                Content="&#xE8C8;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Tag="{x:Bind Name}"
                                ToolTipService.ToolTip="Copy ${secret:NAME} token" />
                            <Button
                                AutomationProperties.Name="Edit"
                                Click="Edit_Click"
                                Content="&#xE70F;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Tag="{x:Bind Name}"
                                ToolTipService.ToolTip="Edit" />
                            <Button
                                AutomationProperties.Name="Delete"
                                Click="Delete_Click"
                                Content="&#xE74D;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Tag="{x:Bind Name}"
                                ToolTipService.ToolTip="Delete" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Name="EmptyText"
            Grid.Row="5"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="No secrets yet. Add one to use it in containers and compose stacks."
            Visibility="Collapsed" />
    </Grid>
</Page>
