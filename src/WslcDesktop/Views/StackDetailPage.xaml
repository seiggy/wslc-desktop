<Page
    x:Class="WslcDesktop.Views.StackDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WslcDesktop.Controls"
    xmlns:svc="using:WslcDesktop.ViewModels">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button
                AutomationProperties.Name="Back to stacks"
                Click="Back_Click"
                Content="&#xE72B;"
                FontFamily="{StaticResource SymbolThemeFontFamily}" />
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1" Padding="16,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource ColumnHeaderStyle}" Text="Service" />
            <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeaderStyle}" Text="Container" />
            <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeaderStyle}" Text="State" />
        </Grid>

        <ListView
            x:Name="Services"
            Grid.Row="2"
            MaxHeight="220"
            IsItemClickEnabled="True"
            ItemClick="Services_ItemClick"
            ItemContainerStyle="{StaticResource RowItemStyle}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="svc:ContainerItem">
                    <Grid Padding="16,8" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Service, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind RunningVisibility, Mode=OneWay}" />
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource TextFillColorDisabledBrush}" Visibility="{x:Bind StoppedVisibility, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind State, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="3" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Logs" VerticalAlignment="Center" />
                <Button Click="Clear_Click" Content="Clear" />
            </StackPanel>
            <controls:OutputView x:Name="LogView" Grid.Row="1" />
        </Grid>
    </Grid>
</Page>
