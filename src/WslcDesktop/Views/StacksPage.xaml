<Page
    x:Class="WslcDesktop.Views.StacksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:WslcDesktop.ViewModels">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Stacks" />
            <Button
                x:Name="OpenButton"
                Grid.Column="1"
                Click="Open_Click"
                Content="Open compose file"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <InfoBar
            x:Name="ErrorBar"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False"
            Severity="Error" />

        <Grid Grid.Row="2" Padding="16,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="136" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource ColumnHeaderStyle}" Text="Stack" />
            <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeaderStyle}" Text="Status" />
        </Grid>

        <ListView
            x:Name="List"
            Grid.Row="3"
            IsItemClickEnabled="True"
            ItemClick="List_ItemClick"
            ItemContainerStyle="{StaticResource RowItemStyle}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="svc:StackItem">
                    <Grid Padding="16,8" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="136" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ServicesText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind AllRunningVisibility, Mode=OneWay}" />
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind PartialVisibility, Mode=OneWay}" />
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource TextFillColorDisabledBrush}" Visibility="{x:Bind StoppedVisibility, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind Summary, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" VerticalAlignment="Center">
                            <Button
                                AutomationProperties.Name="Start stack"
                                Click="Start_Click"
                                Content="&#xE768;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                IsEnabled="{x:Bind AnyStopped, Mode=OneWay}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Tag="{x:Bind Name}"
                                ToolTipService.ToolTip="Start" />
                            <Button
                                AutomationProperties.Name="Stop stack"
                                Click="Stop_Click"
                                Content="&#xE71A;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                IsEnabled="{x:Bind AnyRunning, Mode=OneWay}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Tag="{x:Bind Name}"
                                ToolTipService.ToolTip="Stop" />
                            <Button
                                AutomationProperties.Name="Down stack"
                                Click="Down_Click"
                                Content="&#xE74D;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Tag="{x:Bind Name}"
                                ToolTipService.ToolTip="Down (remove containers)" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Name="EmptyText"
            Grid.Row="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="No stacks yet. Open a compose file to bring one up."
            Visibility="Collapsed" />
    </Grid>
</Page>
