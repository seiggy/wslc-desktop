    <Compile Include="..\..\src\WslcDesktop\Services\StartupPolicy.cs" Link="Linked\StartupPolicy.cs" />
    <Compile Include="..\..\src\WslcDesktop\Services\VolumeSize.cs" Link="Linked\VolumeSize.cs" />
    <Compile Include="..\..\src\WslcDesktop\Services\RunImage.cs" Link="Linked\RunImage.cs" />
